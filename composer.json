{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.7",
        "laravel/breeze": "^2.3",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.3",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Domains\\CourseCatalog\\": "domains/CourseCatalog/app/",
            "App\\Domains\\Curriculum\\": "domains/Curriculum/app/",
            "App\\Domains\\Enrollment\\": "domains/Enrollment/app/",
            "App\\Domains\\Foundation\\": "domains/Foundation/app/",
            "App\\Domains\\IdentityAccess\\": "domains/IdentityAccess/app/",
            "App\\Domains\\Skills\\": "domains/Skills/app/",
            "App\\Domains\\Tenancy\\": "domains/Tenancy/app/",
            "Database\\Factories\\CourseCatalog\\": "domains/CourseCatalog/database/factories/",
            "Database\\Factories\\Curriculum\\": "domains/Curriculum/database/factories/",
            "Database\\Factories\\IdentityAccess\\": "domains/IdentityAccess/database/factories/",
            "Database\\Factories\\Tenancy\\": "domains/Tenancy/database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Seeders\\CourseCatalog\\": "domains/CourseCatalog/database/seeders/",
            "Database\\Seeders\\Curriculum\\": "domains/Curriculum/database/seeders/",
            "Database\\Seeders\\Foundation\\": "domains/Foundation/database/seeders/",
            "Database\\Seeders\\Skills\\": "domains/Skills/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Domains\\CourseCatalog\\": "domains/CourseCatalog/tests/",
            "Tests\\Domains\\Curriculum\\": "domains/Curriculum/tests/",
            "Tests\\Domains\\Enrollment\\": "domains/Enrollment/tests/",
            "Tests\\Domains\\Foundation\\": "domains/Foundation/tests/",
            "Tests\\Domains\\IdentityAccess\\": "domains/IdentityAccess/tests/",
            "Tests\\Domains\\Skills\\": "domains/Skills/tests/",
            "Tests\\Domains\\Tenancy\\": "domains/Tenancy/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "lint": [
            "@phpcs",
            "@phpstan"
        ],
        "lint:fix": [
            "@phpcbf"
        ],
        "phpcs": "phpcs --standard=phpcs.xml",
        "phpcbf": "phpcbf --standard=phpcs.xml",
        "phpstan": "phpstan analyse --memory-limit=2G",
        "test": [
            "@lint",
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
